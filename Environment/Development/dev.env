POSTGRES_HOST=localhost



# Django
APP_ENV=dev
DJANGO_SECRET_KEY=change-me-in-dev
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:8000
DJANGO_SITE_ID=1
DJANGO_COOKIE_DOMAIN=
FRONTEND_URL=http://localhost:3000
DJANGO_AUTH_LOGIN_RATE=10/minute
DJANGO_AUTH_LOGIN_USERNAME_RATE=20/hour
GOOGLE_CLIENT_ID=replace-google-client-id
GOOGLE_CLIENT_SECRET=replace-google-client-secret
GITHUB_CLIENT_ID=replace-github-client-id
GITHUB_CLIENT_SECRET=replace-github-client-secret

# n8n
