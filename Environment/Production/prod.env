# Postgres
POSTGRES_USER=ph_user
POSTGRES_PASSWORD=ph_password
POSTGRES_DB=ph_app
POSTGRES_HOST


# Django
APP_ENV=prod
DJANGO_SECRET_KEY=change-me-in-prod
DJANGO_ALLOWED_HOSTS=app.your-domain.com,api.your-domain.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://app.your-domain.com,https://api.your-domain.com
DJANGO_SITE_ID=1
DJANGO_COOKIE_DOMAIN=.your-domain.com
FRONTEND_URL=https://app.your-domain.com
DJANGO_AUTH_LOGIN_RATE=10/minute
DJANGO_AUTH_LOGIN_USERNAME_RATE=20/hour
GOOGLE_CLIENT_ID=replace-google-client-id
GOOGLE_CLIENT_SECRET=replace-google-client-secret
GITHUB_CLIENT_ID=replace-github-client-id
GITHUB_CLIENT_SECRET=replace-github-client-secret

# n8n
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=postgres
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=n8n_db
DB_POSTGRESDB_USER=ph_user
DB_POSTGRESDB_PASSWORD=ph_password
N8N_HOST=your-domain.com
N8N_PORT=5678
N8N_PROTOCOL=https
N8N_EDITOR_BASE_URL=https://your-domain.com
WEBHOOK_URL=https://your-domain.com
N8N_ENCRYPTION_KEY=change-me-in-prod
