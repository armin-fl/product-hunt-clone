    {
      "parameters": {
        "jsCode": "// Access the static memory to store posts across loop iterations\nconst staticData = $getWorkflowStaticData('global');\n\n// Initialize the array if this is the first run of the loop\nif (!staticData.results) {\n  staticData.results = [];\n}\n\n// 1. Get data from GraphQL response\nconst response = items[0].json.data;\nconst posts = response.posts.edges.map(edge => edge.node);\n\n// 2. Add ALL posts to our master list (No filtering)\nstaticData.results.push(...posts);\n\n// 3. Check if there are more pages\nconst pageInfo = response.posts.pageInfo;\n\nif (pageInfo.hasNextPage) {\n  // If more pages, tell the IF node to continue\n  return {\n    json: {\n      continueLoop: true,\n      nextCursor: pageInfo.endCursor\n    }\n  };\n} else {\n  // If finished, return ALL the collected posts\n  const finalPosts = staticData.results;\n  staticData.results = []; // Clean up memory for next run\n  \n  // Return as individual items so the next node handles them easily\n  return finalPosts.map(post => ({ json: post }));\n}"
      },
      "type": "n8n-nodes-base.code",
