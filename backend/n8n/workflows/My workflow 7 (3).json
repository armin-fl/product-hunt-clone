        "query": "query GetPosts($after: DateTime, $before: DateTime, $cursor: String) {\n  posts(order: VOTES, postedAfter: $after, postedBefore: $before, first: 10, after: $cursor) {\n    edges {\n      node {\n        id\n        votesCount\n        createdAt\n        description\n        featuredAt\n        name\n        slug\n        tagline\n        url\n        website\n        reviewsCount\n        reviewsRating\n        thumbnail { url }\n        # Removed: media, makers, user, productLinks\n      }\n    }\n    pageInfo {\n      hasNextPage\n      endCursor\n    }\n  }\n}",
        "variables": "={{\n  {\n    \"after\": $('Edit Fields').item.json.afterDate,\n    \"before\": $('Edit Fields').item.json.beforeDate,\n    \"cursor\": $json.cursor || null\n  }\n}}"
      },
